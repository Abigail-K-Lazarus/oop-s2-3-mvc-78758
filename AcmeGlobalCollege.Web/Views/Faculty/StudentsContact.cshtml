@model AcmeGlobalCollege.Models.Entities.StudentProfile

@{
    ViewData["Title"] = "Student Contact Details";
}

<h2><i class="fas fa-address-card"></i> Student Contact Information</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5>Personal Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <th width="150">Student ID:</th>
                        <td>@Model.StudentNumber</td>
                    </tr>
                    <tr>
                        <th>Full Name:</th>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <th>Date of Birth:</th>
                        <td>@Model.DateOfBirth.ToString("dd/MM/yyyy")</td>
                    </tr>
                    <tr>
                        <th>Branch:</th>
                        <td>@Model.Branch?.Name</td>
                    </tr>
                    <tr>
                        <th>Status:</th>
                        <td><span class="badge bg-success">@Model.Status</span></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5>Contact Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <th width="150">Email:</th>
                        <td><a href="mailto:@Model.Email">@Model.Email</a></td>
                    </tr>
                    <tr>
                        <th>Phone:</th>
                        <td>@(Model.Phone ?? "Not provided")</td>
                    </tr>
                    <tr>
                        <th>Address:</th>
                        <td>@(Model.Address ?? "Not provided")</td>
                    </tr>
                    <tr>
                        <th>Enrolment Date:</th>
                        <td>@Model.EnrolmentDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="CourseStudents" asp-route-courseId="@ViewBag.CourseId" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Students
    </a>
</div>