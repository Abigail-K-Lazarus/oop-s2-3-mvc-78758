@model IEnumerable<AcmeGlobalCollege.Models.Entities.AttendanceRecord>

@{
    ViewData["Title"] = "My Attendance";
}

<h2><i class="fas fa-calendar-check"></i> My Attendance Records</h2>
<hr />

@if (Model.Any())
{
    var groupedByCourse = Model.GroupBy(a => a.CourseEnrolment.Course.Name);

    foreach (var courseGroup in groupedByCourse)
    {
        var courseName = courseGroup.Key;
        var attendanceList = courseGroup.ToList();
        var presentCount = attendanceList.Count(a => a.IsPresent);
        var totalCount = attendanceList.Count;
        var percentage = totalCount > 0 ? (decimal)presentCount / totalCount * 100 : 0;

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5><i class="fas fa-book"></i> @courseName</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="alert alert-info">
                            <strong>Overall Attendance: @percentage.ToString("F1")%</strong>
                            <div class="progress mt-2">
                                <div class="progress-bar @(percentage >= 75 ? "bg-success" : percentage >= 50 ? "bg-warning" : "bg-danger")"
                                     style="width: @percentage%">
                                    @percentage.ToString("F1")%
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Week</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attendance in attendanceList.OrderByDescending(a => a.WeekNumber))
                            {
                                <tr>
                                    <td>Week @attendance.WeekNumber</td>
                                    <td>@attendance.Date.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (attendance.IsPresent)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> Present
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times-circle"></i> Absent
                                            </span>
                                        }
                                    </td>
                                    <td>@(attendance.Notes ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i> No attendance records found.
    </div>
}