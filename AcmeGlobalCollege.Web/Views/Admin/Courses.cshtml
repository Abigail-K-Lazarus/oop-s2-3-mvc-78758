@model IEnumerable<AcmeGlobalCollege.Models.Entities.Course>

@{
    ViewData["Title"] = "Manage Courses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-book"></i> Courses</h2>
    <a asp-action="CreateCourse" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Course
    </a>
</div>
<hr />

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Branch</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Capacity</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td><strong>@course.Code</strong></td>
                        <td>@course.Name</td>
                        <td>@course.Branch?.Name</td>
                        <td>@course.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@course.EndDate.ToString("dd/MM/yyyy")</td>
                        <td>@course.MaxCapacity</td>
                        <td>
                            <a asp-action="EditCourse" asp-route-id="@course.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="CourseAssignments" asp-route-id="@course.Id" class="btn btn-sm btn-info">
                                <i class="fas fa-chalkboard-user"></i>
                            </a>
                            <button onclick="deleteCourse(@course.Id)" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">No courses found. Click "Add Course" to create one.</div>
}

@section Scripts {
    <script>
        function deleteCourse(id) {
            if (confirm('Are you sure you want to delete this course?')) {
                window.location.href = '/Admin/DeleteCourse/' + id;
            }
        }
    </script>
}