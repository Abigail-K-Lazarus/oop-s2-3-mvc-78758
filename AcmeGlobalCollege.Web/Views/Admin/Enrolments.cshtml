@model IEnumerable<AcmeGlobalCollege.Models.Entities.CourseEnrolment>

@{
    ViewData["Title"] = "Manage Enrolments";
    var students = ViewBag.Students as IEnumerable<AcmeGlobalCollege.Models.Entities.StudentProfile>;
    var courses = ViewBag.Courses as IEnumerable<AcmeGlobalCollege.Models.Entities.Course>;
}

<h2><i class="fas fa-envelope"></i> Course Enrolments</h2>
<hr />

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5>Enrol Student in Course</h5>
            </div>
            <div class="card-body">
                <form asp-action="EnrolStudent" method="post">
                    <div class="mb-3">
                        <label class="form-label">Select Student</label>
                        <select name="studentId" class="form-select" required>
                            <option value="">-- Select Student --</option>
                            @foreach (var student in students)
                            {
                                <option value="@student.Id">@student.Name (@student.StudentNumber)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Select Course</label>
                        <select name="courseId" class="form-select" required>
                            <option value="">-- Select Course --</option>
                            @foreach (var course in courses)
                            {
                                <option value="@course.Id">@course.Code - @course.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-plus"></i> Enrol Student
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<h4>Current Enrolments</h4>
@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Enrolment Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrolment in Model)
                {
                    <tr>
                        <td>@enrolment.StudentProfile?.Name</td>
                        <td>@enrolment.Course?.Code - @enrolment.Course?.Name</td>
                        <td>@enrolment.EnrolDate.ToString("dd/MM/yyyy")</td>
                        <td>@enrolment.Status</td>
                        <td>
                            <form asp-action="WithdrawStudent" method="post" style="display:inline">
                                <input type="hidden" name="studentId" value="@enrolment.StudentProfileId" />
                                <input type="hidden" name="courseId" value="@enrolment.CourseId" />
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Withdraw student?')">
                                    <i class="fas fa-times"></i> Withdraw
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
