@model IEnumerable<AcmeGlobalCollege.Models.Entities.Exam>

@{
    ViewData["Title"] = "Manage Exams";
}

<h2><i class="fas fa-file-alt"></i> Exams & Results Release</h2>
<hr />

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Course</th>
                    <th>Exam Title</th>
                    <th>Date</th>
                    <th>Max Score</th>
                    <th>Results Released</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exam in Model)
                {
                    <tr>
                        <td>@exam.Course?.Code</td>
                        <td>@exam.Title</td>
                        <td>@exam.Date.ToString("dd/MM/yyyy")</td>
                        <td>@exam.MaxScore</td>
                        <td>
                            @if (exam.ResultsReleased)
                            {
                                <span class="badge bg-success">Released</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Provisional</span>
                            }
                        </td>
                        <td>
                            <form asp-action="ReleaseResults" method="post">
                                <input type="hidden" name="examId" value="@exam.Id" />
                                <input type="hidden" name="release" value="@(!exam.ResultsReleased)" />
                                <button type="submit" class="btn btn-sm @(exam.ResultsReleased ? "btn-warning" : "btn-success")">
                                    @if (exam.ResultsReleased)
                                    {
                                        <i class="fas fa-lock"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-unlock-alt"></i>
                                    }
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">No exams created yet.</div>
}